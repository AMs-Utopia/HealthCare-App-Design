        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;erDiagram\n    PATIENT {\n        int patient_id PK\n        string patient_uid\n        string full_name\n        string phone\n        string password\n        date date_of_birth\n        int age\n        string gender\n        string blood_group\n        string profile_image\n    }\n    ADDRESS {\n        int address_id PK\n        int patient_id FK\n        string present_address\n    }\n    DOCTOR {\n        int doctor_id PK\n        string full_name\n        string phone\n        string password\n        string specialization\n        int department_id FK\n    }\n    DOCTOR_DEGREE {\n        int degree_id PK\n        int doctor_id FK\n        string degree_name\n        string institution\n        int year\n    }\n    DEPARTMENT {\n        int department_id PK\n        string department_name\n    }\n    HOSPITAL {\n        int hospital_id PK\n        string hospital_name\n        string area\n        string phone\n        string address\n    }\n    DOCTOR_SCHEDULE {\n        int schedule_id PK\n        int doctor_id FK\n        int hospital_id FK\n        string weekday\n        string offday\n        string time_slot\n        string chamber_no\n        string floor_no\n    }\n    APPOINTMENT {\n        int appointment_id PK\n        int patient_id FK\n        int doctor_id FK\n        int hospital_id FK\n        int schedule_id FK\n        string contact_name\n        string contact_mobile\n        date appointment_date\n        string appointment_time\n        string visit_type\n        string status\n    }\n    HEALTH_RECORD {\n        int record_id PK\n        int patient_id FK\n        string file_type\n        string file_path\n        date upload_date\n    }\n    HEALTH_METRIC {\n        int metric_id PK\n        int patient_id FK\n        float height\n        float weight\n        float bmi\n        string blood_pressure\n        date recorded_at\n    }\n    PRESCRIPTION {\n        int prescription_id PK\n        int patient_id FK\n        int doctor_id FK\n        int medicine_id FK\n        string dosage_instruction\n        int remaining_doses\n        date prescribed_date\n        string status\n    }\n    ORDER_HEADER {\n        int order_id PK\n        int patient_id FK\n        decimal total_cost\n        date order_date\n        string status\n    }\n    ORDER_ITEM {\n        int order_item_id PK\n        int order_id FK\n        int medicine_id FK\n        int quantity\n        decimal unit_price\n    }\n    MEDICINE {\n        int medicine_id PK\n        string medicine_name\n        string dosage\n        decimal price\n    }\n    LAB_TEST {\n        int test_id PK\n        string test_name\n        decimal price\n    }\n    LAB_TEST_ORDER {\n        int lab_order_id PK\n        int patient_id FK\n        int test_id FK\n        date booking_date\n        string status\n    }\n    ARTICLE {\n        int article_id PK\n        string title\n        string category\n        string content\n    }\n\n    PATIENT ||--o{ ADDRESS : has\n    PATIENT ||--o{ APPOINTMENT : books\n    PATIENT ||--o{ HEALTH_RECORD : uploads\n    PATIENT ||--o{ HEALTH_METRIC : tracks\n    PATIENT ||--o{ PRESCRIPTION : receives\n    PATIENT ||--o{ ORDER_HEADER : places\n    PATIENT ||--o{ LAB_TEST_ORDER : books\n\n    DOCTOR }o--|| DEPARTMENT : belongs_to\n    DOCTOR ||--o{ DOCTOR_DEGREE : has\n    DOCTOR ||--o{ DOCTOR_SCHEDULE : creates\n    DOCTOR ||--o{ APPOINTMENT : receives\n    DOCTOR ||--o{ PRESCRIPTION : writes\n\n    HOSPITAL ||--o{ DOCTOR_SCHEDULE : provides\n    HOSPITAL ||--o{ APPOINTMENT : hosts\n    DEPARTMENT ||--o{ DOCTOR : contains\n\n    DOCTOR_SCHEDULE ||--o{ APPOINTMENT : booked_from\n\n    MEDICINE ||--o{ PRESCRIPTION : prescribed_as\n    MEDICINE ||--o{ ORDER_ITEM : ordered_as\n    ORDER_HEADER ||--o{ ORDER_ITEM : contains\n\n    LAB_TEST ||--o{ LAB_TEST_ORDER : selected&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="60Kt9ylgl7dT-chjj2c